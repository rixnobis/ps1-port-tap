	(text "PS1 controller / memory card port pass-through + logic analyser tap"
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "a3f8b324-a50f-4207-b244-17bb925f6034")
	)
	(text "Pinout: psx-spx, docs/ps1/pinouts/controller-ports-and-memory-card-ports.md (master).\nJ1 = console side, J2 = device side, wired 1:1. Pin 10 carries the cable shield straight through.\nMemory card slots have no IRQ (pin 8) and no shield; leave those wires unconnected."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "85a75c19-2257-4f6d-9012-7b670ce8c053")
	)
	(text "Taps: signal lines through 100R (keeps analyser lead capacitance off the bus).\nSupply rails through 10k, so a probe on a rail cannot short it.\nFit 0R in place of 100R for a transparent tap."
		(exclude_from_sim no)
		(at 109.22 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d55b74f5-0912-40f1-83ef-63a2b8e11fc4")
	)
	(text "J3 odd pins = tapped line, even pins = GND.\nPairs: DAT, CMD, 7V5, 3V5, CS, SCK, IRQ, ACK, GND/GND"
		(exclude_from_sim no)
		(at 162.56 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7cc4ef75-8327-4fce-8389-fdb2772acd67")
	)
